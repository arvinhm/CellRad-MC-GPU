# CellRad-MC .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
eggs/
*.egg
.eggs/

# Virtual environments
venv/
env/
.venv/
.env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db
desktop.ini

# Large data files (keep in examples/)
*.tif
*.lif

# Simulation outputs (user-generated)
output_*/
cell_analysis_*/
!examples/

# Temporary files
*.tmp
*.temp
*.log
*.bak

# External dependencies (too large for repo)
geant4-source/
TOPAS-nBio/

# Test outputs
test_results/
test_output/

# NumPy arrays (keep NIfTI only)
*.npy

# But allow validation results
!validation_results/

